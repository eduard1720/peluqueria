@model List<Logica.Modelos.Peluquero>
@{
    ViewData["Title"] = "Peluqueros";
    Layout = "_LayoutPanel";
}
<h1>Peluqueros</h1>
<div class="barra-agenda">
    <a class="btn btn-dark btn-sm" asp-action="Nuevo">Nuevo peluquero</a>
</div>
<partial name="_Mensajes" />

@if (Model.Count == 0)
{
    <p class="text-muted">No hay peluqueros registrados.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Peluquero</th><th>Especialidad</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr class="@(p.Activo ? "" : "inactivo")">
                <td><strong>@p.NombreCompleto</strong></td>
                <td>@p.Especialidad</td>
                <td>@(p.Activo ? "Activo" : "Inactivo")</td>
                <td class="acciones-fila">
                    <a class="btn btn-outline-dark btn-sm" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                    <a class="btn btn-outline-dark btn-sm" asp-controller="Agenda" asp-action="Index" asp-route-peluqueroId="@p.Id">Agenda</a>
                    <form method="post" asp-action="CambiarEstado" asp-route-id="@p.Id" asp-route-activo="@(!p.Activo)">
                        <button class="btn btn-sm @(p.Activo ? "btn-outline-danger" : "btn-outline-success")">@(p.Activo ? "Desactivar" : "Activar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
