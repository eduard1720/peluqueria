@model WebBarberia.Models.ReprogramarViewModel
@{
    ViewData["Title"] = "Reprogramar";
    Layout = "_LayoutPanel";
    var r = Model.Reserva;
}
<h1>Reprogramar reserva</h1>
<div class="resumen">
    <div><span>Cliente</span><strong>@r.Cliente.NombreCompleto · @r.Cliente.Telefono</strong></div>
    <div><span>Servicio</span><strong>@r.Servicio.Nombre (@r.Servicio.DuracionMin min)</strong></div>
    <div><span>Peluquero</span><strong>@r.Peluquero.NombreCompleto</strong></div>
    <div><span>Fecha y hora actuales</span><strong>@r.Fecha.ToString("dd/MM/yyyy") · @r.HoraInicio.ToString("HH:mm")-@r.HoraFin.ToString("HH:mm")</strong></div>
</div>
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }

<form method="get" asp-action="Reprogramar" class="elegir-fecha">
    <input type="hidden" name="id" value="@r.Id" />
    <label for="fecha">Nueva fecha</label>
    <input type="date" id="fecha" name="fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")"
           min="@Model.Hoy.ToString("yyyy-MM-dd")" max="@Model.Hoy.AddDays(Logica.Modelos.HorarioAtencion.DiasMaximos).ToString("yyyy-MM-dd")"
           onchange="this.form.submit()" />
    <noscript><button type="submit" class="btn btn-dark">Ver horarios</button></noscript>
</form>

<h2 class="h5 mt-4">Horarios libres de @r.Peluquero.NombreCompleto el @Model.Fecha.ToString("dd/MM/yyyy")</h2>
@if (Model.Disponibles.Count == 0)
{
    <div class="alert alert-warning">No hay horarios disponibles para esta fecha.</div>
}
else
{
    <div class="bloques">
        @foreach (var h in Model.Disponibles)
        {
            <form method="post" asp-action="Reprogramar">
                <input type="hidden" name="id" value="@r.Id" />
                <input type="hidden" name="fecha" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="hora" value="@h.ToString("HH:mm")" />
                <button type="submit" class="bloque w-100 bg-transparent">@h.ToString("HH:mm")</button>
            </form>
        }
    </div>
}
<p class="mt-3"><a asp-action="Index">&larr; Volver a reservas</a></p>
