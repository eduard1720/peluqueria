@model WebBarberia.Models.ServicioViewModel
@{
    bool nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo servicio" : "Editar servicio";
    Layout = "_LayoutPanel";
}
<h1>@ViewData["Title"]</h1>
<partial name="_Errores" model="Model.Errores" />
<form method="post" asp-action="@(nuevo ? "Nuevo" : "Editar")" class="formulario">
    <input type="hidden" name="Id" value="@Model.Id" />
    <label for="Nombre">Nombre</label>
    <input id="Nombre" name="Nombre" value="@Model.Nombre" class="form-control" maxlength="60" required />
    <label for="Descripcion">Descripción</label>
    <input id="Descripcion" name="Descripcion" value="@Model.Descripcion" class="form-control" maxlength="200" />
    <div class="fila">
        <div>
            <label for="DuracionMin">Duración</label>
            <select id="DuracionMin" name="DuracionMin" class="form-select">
                @for (int m = 30; m <= 180; m += 30)
                {
                    <option value="@m" selected="@(m == Model.DuracionMin)">@m min</option>
                }
            </select>
        </div>
        <div>
            <label for="Precio">Precio (Bs)</label>
            <input id="Precio" name="Precio" value="@Model.Precio" class="form-control" inputmode="decimal" placeholder="35.00" required />
        </div>
    </div>
    <label for="Imagen">Imagen (nombre del archivo, opcional)</label>
    <input id="Imagen" name="Imagen" value="@Model.Imagen" class="form-control" maxlength="200" />
    @if (!nuevo) { <p class="text-muted small mt-2">Cambiar el precio no afecta a las reservas ya registradas (RN-15).</p> }
    <div class="acciones mt-3">
        <button type="submit" class="btn btn-dark">Guardar</button>
        <a class="btn btn-outline-dark" asp-action="Index">Volver</a>
    </div>
</form>
