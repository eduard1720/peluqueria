@model List<string>
@{
    ViewData["Title"] = "Registro de errores";
    Layout = "_LayoutPanel";
}
<h1>Registro de errores</h1>
@if (Model.Count == 0)
{
    <p>Sin errores registrados.</p>
}
else
{
    <ul class="list-unstyled small">
        @foreach (var linea in Model) { <li>@linea</li> }
    </ul>
}
